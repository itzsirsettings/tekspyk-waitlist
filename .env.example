# Railway: Project > your Postgres service > Connect > DATABASE_URL
DATABASE_URL=

# A private value you choose to sign in at /admin in production.
ADMIN_ACCESS_TOKEN=

# SMTP delivery for account verification and password reset. Registration must remain disabled until delivery is verified.
# Missing credentials fail delivery. There is no simulated production email fallback.
#
# SMTP_HOST below is a placeholder. Get the exact host, port, and whether it
# uses SSL (port 465) or STARTTLS (port 587) from your Spaceship email
# hosting dashboard under Email > Settings, since this can vary by plan.
SMTP_HOST=mail.spaceship.com
SMTP_PORT=465
SMTP_USER=hello@tekspyk.com
SMTP_PASSWORD=
SMTP_FROM="TekSpyk <hello@tekspyk.com>"
# Optional owner notification email for each new signup.
ADMIN_NOTIFICATION_EMAIL=

# Required for learning accounts. Generate independently with a cryptographic RNG.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Keep false until email delivery and the privacy/operating process are approved.
LEARNING_REGISTRATION_ENABLED=false
DEPLOYMENT_STAGE=staging

# For migrations only; use an owner connection, never the runtime app role.
MIGRATION_DATABASE_URL=
# A trusted PEM certificate, with literal \n escapes if stored on one line.
# On Railway, use the database's verified root CA and its private server name.
DATABASE_SSL_CA=
DATABASE_SSL_SERVERNAME=
