# Supabase: Project Settings > Database > Connection string (URI). Do not expose this in browser code.
DATABASE_URL=

# A private value you choose to sign in at /admin in production.
ADMIN_ACCESS_TOKEN=

# SMTP delivery for the waitlist welcome email.
# Uses Spaceship's email hosting (or any standard SMTP mailbox) directly via
# nodemailer, no third-party email API. Leave these unset in development and
# signups will just be logged to data/email-logs.jsonl instead of sent.
#
# SMTP_HOST below is a placeholder. Get the exact host, port, and whether it
# uses SSL (port 465) or STARTTLS (port 587) from your Spaceship email
# hosting dashboard under Email > Settings, since this can vary by plan.
SMTP_HOST=mail.spaceship.com
SMTP_PORT=465
SMTP_USER=hello@tekspyk.com
SMTP_PASSWORD=
SMTP_FROM="TekSpyk <hello@tekspyk.com>"
# Optional owner notification email for each new signup.
ADMIN_NOTIFICATION_EMAIL=
