# dependencies
node_modules/
**/node_modules/

# next.js
app/.next/
app/out/
app/next-env.d.ts

# remotion
video/.remotion/
video/out/

# local runtime data (waitlist signups, email logs — never commit user data)
app/data/*.json
app/data/*.jsonl

# env files (keep templates)
.env
.env.local
.env*.local
!.env.example
!**/.env.example

# testing / coverage
coverage/
*.tsbuildinfo

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# claude code local/runtime state (machine-specific, not shared)
.claude/settings.local.json
.claude/scheduled_tasks.lock
